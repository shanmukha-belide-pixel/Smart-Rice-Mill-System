# Sri Trimula Rice Mill - Configuration Template

# Database Setup
# SQLite (Local Development default): sqlite:///./ricemill.db
# PostgreSQL (AWS RDS Production example): postgresql://db_user:password@hostname:5432/db_name
DATABASE_URL=sqlite:///./ricemill.db

# JWT Security
JWT_SECRET_KEY=sritrimulamilkeysecret98765

# --- SMS Gateway 1: Exotel (Recommended for India) ---
# DLT registration is required under TRAI regulations.
EXOTEL_ACCOUNT_SID=
EXOTEL_API_TOKEN=
EXOTEL_SUBDOMAIN=api.exotel.com
EXOTEL_SENDER_ID=

# --- SMS Gateway 2: Twilio (Global Fallback) ---
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=
